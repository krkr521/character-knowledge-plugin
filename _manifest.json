{
  "manifest_version": 2,
  "id": "github.QlzqQlzq.character-knowledge-plugin",
  "version": "1.0.12",
  "name": "角色知识",
  "description": "保留原图供多模态理解，通过视觉识别、AnimeTrace 与私库补充人物位置及角色身份对应，并提供只读识别和角色知识 API。",
  "author": {
    "name": "QlzqQlzq",
    "url": "https://github.com/QlzqQlzq"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/krkr521/character-knowledge-plugin",
    "homepage": "https://github.com/QlzqQlzq/character-knowledge-plugin",
    "documentation": "https://github.com/QlzqQlzq/character-knowledge-plugin#readme",
    "issues": "https://github.com/QlzqQlzq/character-knowledge-plugin/issues"
  },
  "host_application": {
    "min_version": "1.0.12",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.7.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10.0.0"
    }
  ],
  "capabilities": [
    "send.text",
    "message.get_by_id",
    "llm.generate",
    "api.call",
    "database.save"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
